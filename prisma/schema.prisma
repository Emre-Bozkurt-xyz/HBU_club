generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  theme       String
  location    String
  eventDate   DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Executive {
  id          String   @id @default(cuid())
  name        String
  role        String
  bio         String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Member {
  id          String   @id @default(cuid())
  name        String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HistoryFact {
  id          String   @id @default(cuid())
  fact        String
  source      String?
  createdAt   DateTime @default(now())
}
