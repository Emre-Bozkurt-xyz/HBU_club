# Neon Postgres connection string (copy this file to .env and fill in).
# Get one free at https://neon.tech — use the "pooled" connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Shared password execs use to log into /admin.
ADMIN_PASSWORD="change-me"

# Optional: secret used to sign the admin session cookie.
# If unset, the password is used (so changing the password logs everyone out).
# ADMIN_SESSION_SECRET="some-long-random-string"
